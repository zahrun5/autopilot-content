# API Keys - isi dengan key kamu
OPENROUTER_API_KEY=your_9router_or_openrouter_api_key
PIXABAY_API_KEY=your_pixabay_api_key
FACEBOOK_PAGE_ID=your_fb_page_id
FACEBOOK_ACCESS_TOKEN=your_fb_page_access_token

# Opsional - override default jika perlu
# YOUTUBE_CLIENT_SECRETS=config/yt_client_secrets.json

# Model LLM - ganti sesuai yang tersedia di 9router/OpenRouter
# LLM_MODEL=openai/gpt-4o-mini

# Base URL:
# - Pakai 9router : LLM_BASE_URL=https://9router.ai/api/v1
# - Pakai OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=https://9router.ai/api/v1
